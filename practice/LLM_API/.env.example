# 复制本文件为 .env 并填入自己的值；.env 已被 .gitignore 忽略，不会上传。
# 键名必须与 config.py 里 os.getenv() 的名字一致：写错不报错，只会静默使用默认值。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_CACHE=0.05
LLM_COMPLETION=4.5
LLM_MISS=1.5
MAX_CONTENT=5
KEEP_CONTENT=2
SUMMARY_PROMPT=简化用户信息，用简短的方式进行简要，保留语义压缩字数，你的输出将作为后续交互的历史摘要信息
SYSTEM_PROMPT=你是一个AI助手，当用户问你问题时，请为用户提供可靠的回答，禁止编造。
